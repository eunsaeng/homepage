{
  "name": "homepage-workspace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.7.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin dev",
    "test:e2e": "pnpm --filter e2e test",
